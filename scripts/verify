#!/usr/bin/env bash
# Local equivalent of PR CI (.github/workflows/test.yml: make test, make build)
# plus the linter: make lint test build.
# Flags: --fast  skip lint.
# Never releases or publishes.
set -euo pipefail
cd "$(dirname "$0")/.."

FAST=0
for a in "$@"; do [ "$a" = "--fast" ] && FAST=1; done

command -v go >/dev/null || { echo "go is required (see go.mod)" >&2; exit 1; }
command -v make >/dev/null || { echo "make is required" >&2; exit 1; }

if [ "$FAST" = 0 ]; then
  command -v golangci-lint >/dev/null || {
    echo "golangci-lint is required (https://golangci-lint.run/welcome/install/); or use --fast" >&2
    exit 1
  }
  echo "==> lint"
  make lint
fi
echo "==> test"
make test
echo "==> build"
make build
echo "==> verify OK"
